{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and roles (customer or chef).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "chef"] },
        "photoURL": { "type": "string", "format": "url" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Meal": {
      "title": "Meal",
      "description": "Represents a food item offered by a chef.",
      "type": "object",
      "properties": {
        "chefId": { "type": "string" },
        "chefName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string", "format": "url" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "available": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["chefId", "title", "price", "image", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a food order placed by a customer.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "chefId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mealId": { "type": "string" },
              "title": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "delivered", "cancelled"] },
        "createdAt": { "type": "number" }
      },
      "required": ["customerId", "chefId", "items", "total", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Represents a rating and comment left by a customer for a chef or meal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chefId": { "type": "string" },
        "mealId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhoto": { "type": "string", "format": "url" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["chefId", "customerId", "rating", "comment", "createdAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Represents a delivery person in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "vehicleType": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "rating": { "type": "number" },
        "completedDeliveries": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles for customers and chefs."
    },
    "/meals/{mealId}": {
      "schema": "Meal",
      "description": "Available meals in the marketplace."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews and ratings."
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Active delivery personnel."
    }
  }
}
